# =============================================================================
# Copy to `.env` and fill in.   cp .env.example .env  &&  make secrets
#
# `.env` is gitignored and must NEVER be committed. `make secrets` generates
# cryptographically strong values for every SECRET/KEY field below and rewrites
# your local `.env` in place.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# "development" enables /docs, verbose errors and permissive CORS.
# "production" disables all three. Never ship with "development".
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Postgres — the transactional system of record.
# -----------------------------------------------------------------------------
# Each service owns a private schema inside this one database and is granted
# access to nothing else. See docker/postgres/010-init-schemas.sql.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Per-service database passwords.
#
# Each microservice logs into Postgres as its own role (svc_auth, svc_orders,
# ...) which is granted access to that service's schema and nothing else. One
# shared superuser would make that isolation meaningless, so each gets its own
# credential. `make secrets` generates all of them.
SVC_AUTH_DB_PASSWORD=CHANGE_ME_auth_db_password
SVC_CATALOG_DB_PASSWORD=CHANGE_ME_catalog_db_password
SVC_ORDERS_DB_PASSWORD=CHANGE_ME_orders_db_password
SVC_PAYMENTS_DB_PASSWORD=CHANGE_ME_payments_db_password
SVC_ANALYTICS_DB_PASSWORD=CHANGE_ME_analytics_db_password
SVC_NOTIFICATIONS_DB_PASSWORD=CHANGE_ME_notifications_db_password

# dbt reads the transactional schemas (SELECT only) and owns the two analytics
# schemas it builds into.
DBT_DB_PASSWORD=CHANGE_ME_dbt_db_password

# Port that Postgres is published on *your host machine*, for psql / DBeaver.
# Defaults to 5433 rather than 5432 because a locally installed Postgres very
# commonly already owns 5432, and the collision is a confusing first-run error.
# Inside the compose network services always talk to 5432.
POSTGRES_HOST_PORT=5433

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Signs access + refresh JWTs. 64 hex chars minimum. Rotating it logs everyone
# out, which is the intended behaviour if it ever leaks.
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_64_hex_chars

# Access tokens are short-lived because they are not revocable. Refresh tokens
# are long-lived but ARE revocable (hashed + stored server-side, rotated on use).
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000    # 30 days

# Secret for the double-submit CSRF cookie. Must differ from JWT_SECRET_KEY.
CSRF_SECRET_KEY=CHANGE_ME_csrf_secret_64_hex_chars

# Cookie scope. For local dev "localhost" is correct. In production set this to
# your apex domain (e.g. "example.com") so cookies work across subdomains.
COOKIE_DOMAIN=localhost
# MUST be true in production (cookies only sent over HTTPS). false for local HTTP.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Admin bootstrap — this is YOUR account.
# -----------------------------------------------------------------------------
# On first boot the auth service creates exactly one admin with these details.
# Only addresses in ADMIN_EMAILS can ever hold the `admin` role; promoting a
# user outside this list is rejected at the database level.
ADMIN_EMAILS=you@example.com
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars

# -----------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------------------------------
# Use the TEST keys (sk_test_… / pk_test_…) until you go live.
# The secret key must never reach the browser; only the publishable key does.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
# From `stripe listen --forward-to localhost:8080/api/payments/webhook`,
# or the Dashboard → Developers → Webhooks. Required: unsigned webhooks are
# rejected, so payments will not confirm without it.
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CURRENCY=usd

# -----------------------------------------------------------------------------
# Email (notifications service)
# -----------------------------------------------------------------------------
# Dev default points at Mailpit, which catches every outbound mail and shows it
# at http://localhost:8025 — nothing is actually delivered. Swap for SES /
# Postmark / Resend credentials in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=Atelier

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# Browser origins allowed to call the gateway. Comma-separated, no trailing slash.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Public URL of the gateway, used in emails and by the browser.
PUBLIC_API_URL=http://localhost:8080
# Public URL of the storefront, used for Stripe redirects and email links.
PUBLIC_WEB_URL=http://localhost:3000

# Host ports the stack publishes. Change these if something on your machine
# already owns 8080 or 3000; PUBLIC_API_URL and NEXT_PUBLIC_API_URL must then
# be updated to match, since the browser uses them to find the gateway.
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000

# Gateway rate limiting (per client IP).
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Next.js frontend
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the JS bundle and are PUBLIC by
# definition. Never put a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
NEXT_PUBLIC_SITE_NAME=Atelier
